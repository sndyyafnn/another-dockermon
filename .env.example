# Docker NOC Monitor - Environment Configuration

# ── Database ──────────────────────────────────────────────────────
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=docker_monitor

# ── Auth ──────────────────────────────────────────────────────────
# Use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=24h

# ── Docker ────────────────────────────────────────────────────────
DOCKER_SOCKET=/var/run/docker.sock

# ── App ───────────────────────────────────────────────────────────
PORT=3200
NODE_ENV=production
